VITE_API_BASE_URL=/api/v1

# 목 저장소를 쓸지. false로 두면 모든 도메인이 실제 API를 호출한다.
VITE_USE_MOCKS=true

# 인증만 실제 백엔드에 붙일 때 false. 비워두면 VITE_USE_MOCKS를 따른다.
VITE_USE_MOCKS_AUTH=

# Vite dev 서버가 /api 요청을 넘길 백엔드 주소. 비워두면 http://localhost:8080
VITE_API_PROXY_TARGET=

# Vite 개발 서버의 /socket.io WebSocket 프록시. 기본 http://localhost:3001
VITE_CHAT_PROXY_TARGET=
# 별도 도메인으로 직접 연결할 때만 사용. 비워 두면 같은 Origin의 /socket.io 사용.
VITE_CHAT_SOCKET_URL=

# 카카오 앱 키 없이 로그인 흐름을 돌릴 때 true.
# 브라우저가 카카오로 나가지 않고 콜백으로 바로 돌아온다. 실연동 시에는 백엔드도
# 인가 코드를 그대로 회원번호로 쓰는 대역 모드여야 한다.
VITE_KAKAO_STUB=

# 카카오 REST API 키. 인가 코드 방식은 JavaScript 키가 아니라 REST API 키를 쓴다.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/callback
